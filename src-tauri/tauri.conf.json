{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "한글로",
  "version": "0.1.0",
  "identifier": "com.genius.hangulo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popup",
        "title": "한글로",
        "url": "index.html",
        "width": 360,
        "height": 120,
        "minWidth": 240,
        "minHeight": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "한글로 설정",
        "url": "settings.html",
        "width": 320,
        "height": 160,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "온 우주를 한글로",
    "longDescription": "어디서 온 글이든 복사 두 번이면 한글로 옮겨 담아 커서 옆에 띄워 줍니다.",
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
